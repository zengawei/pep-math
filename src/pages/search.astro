---
// src/pages/search.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="搜索">
  <h1 class="text-2xl font-bold mb-4">搜索</h1>

  <link is:inline href="/pep-math/pagefind/pagefind-ui.css" rel="stylesheet" />
  <style is:inline>
    .source-tag { display: inline-block; font-size: 0.7rem; padding: 1px 6px; border-radius: 4px; margin-left: 6px; vertical-align: middle; }
    .source-tag-ncee { background: #DBEAFE; color: #1D4ED8; }
    .source-tag-textbook { background: #D1FAE5; color: #065F46; }
    .source-tag-knowledge { background: #FEF3C7; color: #92400E; }
  </style>
  <div id="search"></div>
  <script is:inline>
    var s = document.createElement('script');
    s.src = '/pep-math/pagefind/pagefind-ui.js';
    s.onload = function() {
      new window.PagefindUI({
        element: "#search",
        basePath: "/pep-math/pagefind/",
        showSubResults: true,
        renderResult: function(result) {
          var url = result.url || '';
          var tag = '';
          if (url.indexOf('/ncee/question/') !== -1) {
            tag = '<span class="source-tag source-tag-ncee">高考真题</span>';
          } else if (url.indexOf('/textbook/') !== -1) {
            tag = '<span class="source-tag source-tag-textbook">教材习题</span>';
          } else if (url.indexOf('/knowledge/') !== -1) {
            tag = '<span class="source-tag source-tag-knowledge">知识点</span>';
          }
          return '<a href="' + result.url + '">' +
            '<div class="pagefind-ui__result-title">' + result.meta.title + tag + '</div>' +
            '<div class="pagefind-ui__result-excerpt">' + result.excerpt + '</div>' +
            '</a>';
        }
      });
    };
    document.head.appendChild(s);
  </script>
</BaseLayout>
