---
// src/pages/search.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="搜索">
  <h1 class="text-2xl font-bold mb-4">搜索</h1>

  <link is:inline href="/pep-math/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script is:inline type="module" src="/pep-math/pagefind/pagefind-ui.js"></script>

  <div id="search"></div>

  <script is:inline type="module">
    import { PagefindUI } from '/pep-math/pagefind/pagefind-ui.js';
    new PagefindUI({
      element: "#search",
      basePath: "/pep-math/pagefind/",
      showSubResults: true,
    });
  </script>
</BaseLayout>
