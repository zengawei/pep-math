---
// src/pages/textbook/[id]/chapter/[chapter]/section/[section].astro
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Navigation from '../../../../../../components/Navigation';
import fs from 'fs';
import path from 'path';

export function getStaticPaths() {
  const textbooksDir = path.resolve('src/content/textbooks');
  const paths: { params: { id: string; chapter: string; section: string } }[] = [];

  const textbooks = fs.readdirSync(textbooksDir).filter(f =>
    fs.statSync(path.join(textbooksDir, f)).isDirectory()
  );

  for (const textbook of textbooks) {
    const textbookDir = path.join(textbooksDir, textbook);
    const chapters = fs.readdirSync(textbookDir).filter(f =>
      fs.statSync(path.join(textbookDir, f)).isDirectory()
    );
    for (const chapterDir of chapters) {
      const chapterPath = path.join(textbookDir, chapterDir);
      const chapterNum = parseInt(chapterDir.replace('chapter-', ''), 10);
      const sections = fs.readdirSync(chapterPath).filter(f =>
        fs.statSync(path.join(chapterPath, f)).isDirectory() && f.startsWith('section-')
      );
      for (const sectionDir of sections) {
        const sectionNum = parseInt(sectionDir.replace('section-', ''), 10);
        paths.push({
          params: {
            id: textbook,
            chapter: String(chapterNum),
            section: String(sectionNum),
          },
        });
      }
    }
  }
  return paths;
}

const { id } = Astro.params;
const chapterNum = parseInt(Astro.params.chapter!, 10);
const sectionNum = parseInt(Astro.params.section!, 10);

// Load section data from pre-built JSON
const sectionDataFile = path.resolve(
  `public/data/sections/${id}-ch${chapterNum}-s${sectionNum}.json`
);
const sectionData = JSON.parse(fs.readFileSync(sectionDataFile, 'utf-8'));

// Load NCEE questions for this chapter
const nceeByChapterFile = path.resolve(`public/data/ncee/by-chapter/${id}/ch${chapterNum}.json`);
let nceeQuestions: any[] = [];
if (fs.existsSync(nceeByChapterFile)) {
  nceeQuestions = JSON.parse(fs.readFileSync(nceeByChapterFile, 'utf-8'));
}

// Build navigation data
const textbooksDir = path.resolve('src/content/textbooks');
const textbookDir = path.join(textbooksDir, id!);
const allChapters = fs.readdirSync(textbookDir)
  .filter(f => fs.statSync(path.join(textbookDir, f)).isDirectory())
  .sort()
  .map(chDir => {
    const chNum = parseInt(chDir.replace('chapter-', ''), 10);
    const chPath = path.join(textbookDir, chDir);
    const sects = fs.readdirSync(chPath)
      .filter(f => fs.statSync(path.join(chPath, f)).isDirectory() && f.startsWith('section-'))
      .sort()
      .map(sDir => ({
        number: parseInt(sDir.replace('section-', ''), 10),
        title: '',
      }));
    return { number: chNum, title: '', sections: sects };
  });
---
<BaseLayout title={`第${chapterNum}章 第${sectionNum}节`}>
  <div class="flex gap-6">
    <!-- Sidebar Navigation -->
    <aside class="w-64 flex-shrink-0 hidden md:block">
      <Navigation
        textbookId={id!}
        chapters={allChapters}
        currentChapter={chapterNum}
        currentSection={sectionNum}
      />
    </aside>

    <!-- Main Content -->
    <div class="flex-1">
      <h1 class="text-2xl font-bold mb-4">
        第{chapterNum}章 第{sectionNum}节
      </h1>

      <!-- Definitions -->
      {sectionData.definitions.length > 0 && (
        <section class="mb-6">
          <h2 class="text-lg font-bold mb-2 border-b pb-1">📖 定义</h2>
          <ul class="space-y-2">
            {sectionData.definitions.map((def: any) => (
              <li class="border rounded p-3">
                <span class="font-medium">{def.name}</span>
                <div class="flex flex-wrap gap-1 mt-1">
                  {def.related_knowledge_points.map((kp: string) => (
                    <a href={`/pep-math/knowledge/${kp}`} class="text-xs text-blue-600 hover:underline">
                      {kp}
                    </a>
                  ))}
                </div>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Exercises (loaded from JSON) -->
      {sectionData.exercises.length > 0 && (
        <section class="mb-6">
          <h2 class="text-lg font-bold mb-2 border-b pb-1">📝 课后练习</h2>
          <div id="exercises-container" data-section-id={`${id}-ch${chapterNum}-s${sectionNum}`}>
            {sectionData.exercises.map((ex: any) => (
              <div id={`exercise-${ex.id}`} class="mb-2 text-sm text-gray-600" style="cursor:pointer">
                第{ex.number}题 —
                <span class={`px-1 rounded text-xs ${
                  ex.difficulty === 'basic' ? 'bg-green-100 text-green-800' :
                  ex.difficulty === 'medium' ? 'bg-yellow-100 text-yellow-800' :
                  'bg-red-100 text-red-800'
                }`}>
                  {ex.difficulty === 'basic' ? '基础' : ex.difficulty === 'medium' ? '中等' : '拔尖'}
                </span>
                {ex.group && (
                  <span class="px-1 rounded text-xs bg-blue-100 text-blue-800 ml-1">
                    {ex.group}组
                  </span>
                )}
              </div>
            ))}
          </div>
          <p class="text-xs text-gray-400 mt-2">
            💡 点击题目可展开解答。
          </p>
        </section>
      )}

      <!-- Chapter Review Exercises -->
      {sectionData.review_exercises && sectionData.review_exercises.length > 0 && (
        <section class="mb-6">
          <h2 class="text-lg font-bold mb-2 border-b pb-1">📋 章节复习题</h2>
          <div id="review-exercises-container">
            {sectionData.review_exercises.map((ex: any) => (
              <div id={`exercise-${ex.id}`} class="mb-2 text-sm text-gray-600" style="cursor:pointer">
                复习题 {ex.number} —
                <span class={`px-1 rounded text-xs ${
                  ex.difficulty === 'basic' ? 'bg-green-100 text-green-800' :
                  ex.difficulty === 'medium' ? 'bg-yellow-100 text-yellow-800' :
                  'bg-red-100 text-red-800'
                }`}>
                  {ex.difficulty === 'basic' ? '基础' : ex.difficulty === 'medium' ? '中等' : '拔尖'}
                </span>
                {ex.group && (
                  <span class="px-1 rounded text-xs bg-blue-100 text-blue-800 ml-1">
                    {ex.group}组
                  </span>
                )}
              </div>
            ))}
          </div>
          <p class="text-xs text-gray-400 mt-2">
            💡 点击题目可展开解答。
          </p>
        </section>
      )}

      <!-- Examples -->
      {sectionData.examples.length > 0 && (
        <section class="mb-6">
          <h2 class="text-lg font-bold mb-2 border-b pb-1">📚 例题</h2>
          <div id="examples-container">
            {sectionData.examples.map((ex: any) => (
              <div id={`example-${ex.id}`} class="mb-2 text-sm text-gray-600" style="cursor:pointer">
                例题 {ex.number}
              </div>
            ))}
          </div>
          <p class="text-xs text-gray-400 mt-2">
            💡 点击例题可展开查看详细解答。
          </p>
        </section>
      )}

      <!-- NCEE Questions -->
      {nceeQuestions.length > 0 && (
        <section class="mb-6">
          <h2 class="text-lg font-bold mb-2 border-b pb-1">🎯 高考真题</h2>
          <p class="text-sm text-gray-500 mb-2">共 {nceeQuestions.length} 道真题涉及本章内容</p>
          <div class="flex gap-2 mb-3">
            <select id="ncee-ch-filter-type" class="border rounded px-2 py-1 text-xs">
              <option value="">全部题型</option>
              <option value="choice">选择题</option>
              <option value="fill_blank">填空题</option>
              <option value="solution">解答题</option>
            </select>
            <select id="ncee-ch-filter-diff" class="border rounded px-2 py-1 text-xs">
              <option value="">全部难度</option>
              <option value="basic">基础</option>
              <option value="medium">中等</option>
              <option value="hard">拔尖</option>
            </select>
          </div>
          <div id="ncee-ch-list" class="space-y-1"></div>
          <div id="ncee-ch-pagination" class="flex gap-1 mt-3 flex-wrap"></div>
        </section>
      )}
    </div>
  </div>

  {nceeQuestions.length > 0 && (
    <script is:inline set:html={`
      (function() {
        var questions = ${JSON.stringify(nceeQuestions)};
        var PAGE_SIZE = 20;
        var currentPage = 1;
        var filtered = questions.slice();

        function diffLabel(d) { return d === 'basic' ? '基础' : d === 'medium' ? '中等' : '拔尖'; }
        function diffClass(d) { return d === 'basic' ? 'bg-green-100 text-green-800' : d === 'medium' ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800'; }
        function typeLabel(t) { return t === 'choice' ? '选择' : t === 'fill_blank' ? '填空' : '解答'; }

        function applyFilters() {
          var typeVal = document.getElementById('ncee-ch-filter-type').value;
          var diffVal = document.getElementById('ncee-ch-filter-diff').value;
          filtered = questions.filter(function(q) {
            if (typeVal && q.question_type !== typeVal) return false;
            if (diffVal && q.difficulty !== diffVal) return false;
            return true;
          });
          currentPage = 1;
          render();
        }

        function render() {
          var list = document.getElementById('ncee-ch-list');
          var pag = document.getElementById('ncee-ch-pagination');
          var start = (currentPage - 1) * PAGE_SIZE;
          var page = filtered.slice(start, start + PAGE_SIZE);
          var totalPages = Math.ceil(filtered.length / PAGE_SIZE) || 1;

          var byYear = {};
          page.forEach(function(q) {
            if (!byYear[q.year]) byYear[q.year] = [];
            byYear[q.year].push(q);
          });

          var html = '';
          Object.keys(byYear).sort(function(a,b) { return b - a; }).forEach(function(year) {
            html += '<div class="text-xs font-medium text-gray-400 mt-2 mb-1">' + year + '年</div>';
            byYear[year].forEach(function(q) {
              html += '<div class="flex items-center justify-between text-sm py-1 px-2 rounded hover:bg-gray-50">';
              html += '<div class="flex items-center gap-2">';
              html += '<span class="text-xs text-gray-400">' + q.paper + '</span>';
              html += '<span class="text-xs">第' + q.question_number + '题</span>';
              html += '<span class="px-1 rounded text-xs ' + diffClass(q.difficulty) + '">' + diffLabel(q.difficulty) + '</span>';
              html += '<span class="px-1 rounded text-xs bg-gray-100 text-gray-600">' + typeLabel(q.question_type) + '</span>';
              html += '</div>';
              html += '<a href="/pep-math/ncee/question/' + q.ncee_id + '" class="text-xs text-blue-600 hover:underline">详情 →</a>';
              html += '</div>';
            });
          });

          if (filtered.length === 0) html = '<p class="text-sm text-gray-400">无匹配结果</p>';
          list.innerHTML = html;

          var pagHtml = '';
          if (totalPages > 1) {
            if (currentPage > 1) pagHtml += '<button onclick="nceeChGoPage(' + (currentPage-1) + ')" class="px-2 py-1 text-xs border rounded hover:bg-gray-50">← 上一页</button>';
            for (var i = 1; i <= totalPages; i++) {
              var active = i === currentPage ? 'bg-blue-600 text-white' : 'border hover:bg-gray-50';
              pagHtml += '<button onclick="nceeChGoPage(' + i + ')" class="px-2 py-1 text-xs rounded ' + active + '">' + i + '</button>';
            }
            if (currentPage < totalPages) pagHtml += '<button onclick="nceeChGoPage(' + (currentPage+1) + ')" class="px-2 py-1 text-xs border rounded hover:bg-gray-50">下一页 →</button>';
          }
          pag.innerHTML = pagHtml;
        }

        window.nceeChGoPage = function(p) { currentPage = p; render(); };
        document.getElementById('ncee-ch-filter-type').addEventListener('change', applyFilters);
        document.getElementById('ncee-ch-filter-diff').addEventListener('change', applyFilters);
        render();
      })();
    `} />
  )}

  <!-- Exercise/example click-to-expand with KaTeX math rendering -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      var base = '/pep-math';

      function renderMathIn(el) {
        if (typeof renderMathInElement === 'function') {
          renderMathInElement(el, {
            delimiters: [
              {left: '$$', right: '$$', display: true},
              {left: '$', right: '$', display: false},
            ],
            throwOnError: false,
          });
        }
      }

      function escapeHtml(str) {
        var div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
      }

      // Exercise click-to-expand
      document.querySelectorAll('[id^="exercise-"]').forEach(function(el) {
        el.style.cursor = 'pointer';
        el.addEventListener('click', async function() {
          var exId = el.id.replace('exercise-', '');
          var existing = el.querySelector('.exercise-detail');
          if (existing) { existing.remove(); return; }
          try {
            var resp = await fetch(base + '/data/exercises/' + exId + '.json');
            var data = await resp.json();

            var html = '';
            html += '<div class="font-medium mb-3">' + escapeHtml(data.question) + '</div>';

            if (data.steps && data.steps.length > 0) {
              html += '<div class="space-y-3 mb-3">';
              data.steps.forEach(function(step, i) {
                html += '<div class="border-l-2 border-blue-300 pl-3">';
                html += '<div class="font-medium text-blue-700">第' + (i+1) + '步：' + escapeHtml(step.title) + '</div>';
                html += '<div class="text-xs text-blue-500 mb-1">📌 运用知识点：' + escapeHtml(step.knowledge_point) + '</div>';
                html += '<div class="text-gray-700">' + escapeHtml(step.content) + '</div>';
                html += '</div>';
              });
              html += '</div>';
            }

            if (data.warning) {
              html += '<div class="mt-2 p-2 bg-yellow-50 border border-yellow-200 rounded text-yellow-800 text-sm">⚠️ 易错提醒：' + escapeHtml(data.warning) + '</div>';
            }

            if (data.summary) {
              html += '<div class="mt-2 p-2 bg-green-50 border border-green-200 rounded text-green-800 text-sm">💡 解题思路总结：' + escapeHtml(data.summary) + '</div>';
            }

            var detail = document.createElement('div');
            detail.className = 'exercise-detail mt-2 p-3 bg-gray-50 rounded text-sm';
            detail.innerHTML = html;
            el.appendChild(detail);

            renderMathIn(detail);
          } catch (e) {
            console.error('Failed to load exercise:', e);
          }
        });
      });

      // Example click-to-expand
      document.querySelectorAll('[id^="example-"]').forEach(function(el) {
        el.style.cursor = 'pointer';
        el.addEventListener('click', async function() {
          var egId = el.id.replace('example-', '');
          var existing = el.querySelector('.example-detail');
          if (existing) { existing.remove(); return; }
          try {
            var resp = await fetch(base + '/data/examples/' + egId + '.json');
            var data = await resp.json();

            var html = '';
            html += '<div class="font-medium mb-3">' + escapeHtml(data.question) + '</div>';

            if (data.steps && data.steps.length > 0) {
              html += '<div class="space-y-3 mb-3">';
              data.steps.forEach(function(step, i) {
                html += '<div class="border-l-2 border-purple-300 pl-3">';
                html += '<div class="font-medium text-purple-700">第' + (i+1) + '步：' + escapeHtml(step.title) + '</div>';
                if (step.knowledge_point) {
                  html += '<div class="text-xs text-purple-500 mb-1">📌 运用知识点：' + escapeHtml(step.knowledge_point) + '</div>';
                }
                html += '<div class="text-gray-700">' + escapeHtml(step.content) + '</div>';
                html += '</div>';
              });
              html += '</div>';
            }

            if (data.warning) {
              html += '<div class="mt-2 p-2 bg-yellow-50 border border-yellow-200 rounded text-yellow-800 text-sm">⚠️ 注意：' + escapeHtml(data.warning) + '</div>';
            }

            if (data.summary) {
              html += '<div class="mt-2 p-2 bg-green-50 border border-green-200 rounded text-green-800 text-sm">💡 解题思路总结：' + escapeHtml(data.summary) + '</div>';
            }

            var detail = document.createElement('div');
            detail.className = 'example-detail mt-2 p-3 bg-gray-50 rounded text-sm';
            detail.innerHTML = html;
            el.appendChild(detail);

            renderMathIn(detail);
          } catch (e) {
            console.error('Failed to load example:', e);
          }
        });
      });
    });
  </script>
</BaseLayout>
