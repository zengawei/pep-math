---
// src/pages/knowledge/[id].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import MathFormula from '../../components/MathFormula';
import { getCollection } from 'astro:content';
import fs from 'fs';
import path from 'path';

export async function getStaticPaths() {
  const knowledgePoints = await getCollection('knowledge-points');
  return knowledgePoints.map((kp) => ({
    params: { id: kp.data.id },
    props: { kp },
  }));
}

const { kp } = Astro.props;
const { data } = kp;

// Load related exercises from pre-built JSON
const exercisesByKpFile = path.resolve(`public/data/exercises-by-kp/${data.id}.json`);
let exercises: any[] = [];
if (fs.existsSync(exercisesByKpFile)) {
  exercises = JSON.parse(fs.readFileSync(exercisesByKpFile, 'utf-8'));
}

// Load NCEE questions for this knowledge point
const nceeByKpFile = path.resolve(`public/data/ncee/by-kp/${data.id}.json`);
let nceeQuestions: any[] = [];
if (fs.existsSync(nceeByKpFile)) {
  nceeQuestions = JSON.parse(fs.readFileSync(nceeByKpFile, 'utf-8'));
}
---
<BaseLayout title={data.name}>
  <div class="max-w-3xl">
    <!-- Header -->
    <div class="mb-6">
      <span class="text-sm text-gray-400">{data.category}</span>
      <h1 class="text-2xl font-bold">{data.name}</h1>
    </div>

    <!-- Description -->
    <section class="mb-6">
      <h2 class="text-lg font-bold mb-2 border-b pb-1">📖 定义与核心概念</h2>
      <p class="text-gray-700 whitespace-pre-line">{data.description}</p>
    </section>

    <!-- Formulas -->
    {data.formulas.length > 0 && (
      <section class="mb-6">
        <h2 class="text-lg font-bold mb-2 border-b pb-1">📐 关键公式</h2>
        <div class="space-y-2">
          {data.formulas.map((formula: string) => (
            <div class="bg-gray-50 rounded p-3 overflow-x-auto">
              <MathFormula formula={formula} displayMode={true} />
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Knowledge Relations -->
    <section class="mb-6">
      <h2 class="text-lg font-bold mb-2 border-b pb-1">🔗 知识关联</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {data.prerequisites.length > 0 && (
          <div>
            <h3 class="text-sm font-medium text-gray-500 mb-1">前置知识</h3>
            <ul class="space-y-1">
              {data.prerequisites.map((p: string) => (
                <li>
                  <a href={`/pep-math/knowledge/${p}`} class="text-blue-600 hover:underline text-sm">
                    ← {p}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        {data.follow_ups.length > 0 && (
          <div>
            <h3 class="text-sm font-medium text-gray-500 mb-1">后续知识</h3>
            <ul class="space-y-1">
              {data.follow_ups.map((f: string) => (
                <li>
                  <a href={`/pep-math/knowledge/${f}`} class="text-blue-600 hover:underline text-sm">
                    {f} →
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        {data.related.length > 0 && (
          <div>
            <h3 class="text-sm font-medium text-gray-500 mb-1">横向关联</h3>
            <ul class="space-y-1">
              {data.related.map((r: string) => (
                <li>
                  <a href={`/pep-math/knowledge/${r}`} class="text-blue-600 hover:underline text-sm">
                    ↔ {r}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>

    <!-- Common Mistakes -->
    {data.common_mistakes.length > 0 && (
      <section class="mb-6">
        <h2 class="text-lg font-bold mb-2 border-b pb-1">⚠️ 常见错误</h2>
        <div class="space-y-3">
          {data.common_mistakes.map((cm: any) => (
            <div class="bg-red-50 border border-red-200 rounded p-3">
              <div class="text-sm">
                <span class="font-medium text-red-700">❌ 错误：</span>
                {cm.mistake}
              </div>
              <div class="text-sm mt-1">
                <span class="font-medium text-green-700">✅ 纠正：</span>
                {cm.correction}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Related Exercises -->
    {exercises.length > 0 && (
      <section class="mb-6">
        <h2 class="text-lg font-bold mb-2 border-b pb-1">📝 相关习题</h2>
        <p class="text-sm text-gray-500 mb-2">共 {exercises.length} 道习题，按难度排序</p>
        <ul class="space-y-1">
          {exercises.map((ex: any) => {
            const isReview = ex.section === 0 || ex.category === 'review';
            const linkHref = isReview
              ? `/pep-math/textbook/${ex.textbook}/chapter/${ex.chapter}/section/1`
              : `/pep-math/textbook/${ex.textbook}/chapter/${ex.chapter}/section/${ex.section}`;
            const label = isReview
              ? `${ex.textbook} 第${ex.chapter}章 复习 第${ex.number}题`
              : `${ex.textbook} 第${ex.chapter}章 第${ex.section}节 第${ex.number}题`;
            return (
              <li class="flex items-center gap-2 text-sm">
                <a href={linkHref} class="text-blue-600 hover:underline">
                  {label}
                </a>
                <span class={`px-1 rounded text-xs ${
                  ex.difficulty === 'basic' ? 'bg-green-100 text-green-800' :
                  ex.difficulty === 'medium' ? 'bg-yellow-100 text-yellow-800' :
                  'bg-red-100 text-red-800'
                }`}>
                  {ex.difficulty === 'basic' ? '基础' : ex.difficulty === 'medium' ? '中等' : '拔尖'}
                </span>
                {isReview && <span class="px-1 rounded text-xs bg-purple-100 text-purple-800">复习</span>}
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <!-- NCEE Questions -->
    {nceeQuestions.length > 0 && (
      <section class="mb-6">
        <h2 class="text-lg font-bold mb-2 border-b pb-1">🎯 高考真题</h2>
        <p class="text-sm text-gray-500 mb-2">共 {nceeQuestions.length} 道真题涉及此知识点</p>

        <!-- Sub-filters -->
        <div class="flex gap-2 mb-3">
          <select id="ncee-filter-type" class="border rounded px-2 py-1 text-xs">
            <option value="">全部题型</option>
            <option value="choice">选择题</option>
            <option value="fill_blank">填空题</option>
            <option value="solution">解答题</option>
          </select>
          <select id="ncee-filter-diff" class="border rounded px-2 py-1 text-xs">
            <option value="">全部难度</option>
            <option value="basic">基础</option>
            <option value="medium">中等</option>
            <option value="hard">拔尖</option>
          </select>
        </div>

        <div id="ncee-list" class="space-y-1"></div>
        <div id="ncee-pagination" class="flex gap-1 mt-3 flex-wrap"></div>
      </section>
    )}
  </div>

  {nceeQuestions.length > 0 && (
    <script is:inline set:html={`
      (function() {
        var questions = ${JSON.stringify(nceeQuestions)};
        var PAGE_SIZE = 20;
        var currentPage = 1;
        var filtered = questions.slice();

        function diffLabel(d) { return d === 'basic' ? '基础' : d === 'medium' ? '中等' : '拔尖'; }
        function diffClass(d) { return d === 'basic' ? 'bg-green-100 text-green-800' : d === 'medium' ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800'; }
        function typeLabel(t) { return t === 'choice' ? '选择' : t === 'fill_blank' ? '填空' : '解答'; }

        function applyFilters() {
          var typeVal = document.getElementById('ncee-filter-type').value;
          var diffVal = document.getElementById('ncee-filter-diff').value;
          filtered = questions.filter(function(q) {
            if (typeVal && q.question_type !== typeVal) return false;
            if (diffVal && q.difficulty !== diffVal) return false;
            return true;
          });
          currentPage = 1;
          render();
        }

        function render() {
          var list = document.getElementById('ncee-list');
          var pag = document.getElementById('ncee-pagination');
          var start = (currentPage - 1) * PAGE_SIZE;
          var page = filtered.slice(start, start + PAGE_SIZE);
          var totalPages = Math.ceil(filtered.length / PAGE_SIZE) || 1;

          // Group by year
          var byYear = {};
          page.forEach(function(q) {
            if (!byYear[q.year]) byYear[q.year] = [];
            byYear[q.year].push(q);
          });

          var html = '';
          Object.keys(byYear).sort(function(a,b) { return b - a; }).forEach(function(year) {
            html += '<div class="text-xs font-medium text-gray-400 mt-2 mb-1">' + year + '年</div>';
            byYear[year].forEach(function(q) {
              var paperSlug = q.paper_code.replace(/^\\d+-/, '');
              html += '<div class="flex items-center justify-between text-sm py-1 px-2 rounded hover:bg-gray-50">';
              html += '<div class="flex items-center gap-2">';
              html += '<span class="text-xs text-gray-400">' + q.paper + '</span>';
              html += '<span class="text-xs">第' + q.question_number + '题</span>';
              html += '<span class="px-1 rounded text-xs ' + diffClass(q.difficulty) + '">' + diffLabel(q.difficulty) + '</span>';
              html += '<span class="px-1 rounded text-xs bg-gray-100 text-gray-600">' + typeLabel(q.question_type) + '</span>';
              html += '</div>';
              html += '<a href="/pep-math/ncee/question/' + q.ncee_id + '" class="text-xs text-blue-600 hover:underline">详情 →</a>';
              html += '</div>';
            });
          });

          if (filtered.length === 0) {
            html = '<p class="text-sm text-gray-400">无匹配结果</p>';
          }
          list.innerHTML = html;

          // Pagination
          var pagHtml = '';
          if (totalPages > 1) {
            if (currentPage > 1) pagHtml += '<button onclick="nceeGoPage(' + (currentPage-1) + ')" class="px-2 py-1 text-xs border rounded hover:bg-gray-50">← 上一页</button>';
            for (var i = 1; i <= totalPages; i++) {
              var active = i === currentPage ? 'bg-blue-600 text-white' : 'border hover:bg-gray-50';
              pagHtml += '<button onclick="nceeGoPage(' + i + ')" class="px-2 py-1 text-xs rounded ' + active + '">' + i + '</button>';
            }
            if (currentPage < totalPages) pagHtml += '<button onclick="nceeGoPage(' + (currentPage+1) + ')" class="px-2 py-1 text-xs border rounded hover:bg-gray-50">下一页 →</button>';
          }
          pag.innerHTML = pagHtml;
        }

        window.nceeGoPage = function(p) { currentPage = p; render(); };

        document.getElementById('ncee-filter-type').addEventListener('change', applyFilters);
        document.getElementById('ncee-filter-diff').addEventListener('change', applyFilters);
        render();
      })();
    `} />
  )}
</BaseLayout>
